{
  "name": "@haleyjs/vue",
  "private": false,
  "version": "0.0.33",
  "author": "TheHaleyProject",
  "license": "MIT",
  "description": "Contains some useful components for Vue JS",
  "main": "dist/haleyvue.umd.cjs",
  "module": "dist/haleyvue.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "lib/globals.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/haleyvue.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/haleyvue.umd.cjs"
      }
    },
    "./styles.css": "./dist/haleyvue.css"
  },
  "keywords": [
    "vue3",
    "haley vue",
    "haley",
    "haley js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHaleyProject/HaleyVue"
  },
  "scripts": {
    "build": "vue-tsc --noemit false && vite build ",
    "dev": "vite",
    "preview": "vite preview",
    "serve:src": "vite serve src"
  },
  "peerDependencies": {
    "vue": "^3.4.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.6",
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  }
}
